<UserControl x:Class="QuanLyNhanSu_WPF.Views.EmailCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:QuanLyNhanSu_WPF.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource BackgroundBrush}">
             
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToStringConverter x:Key="BoolToStr"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Trung Tâm Gửi Email" FontSize="24" FontWeight="Bold" Margin="0,0,0,24" Foreground="{DynamicResource PrimaryHueDarkBrush}"/>

        <!-- Left Panel: Employee Selection -->
        <materialDesign:Card Grid.Row="1" Grid.Column="0" materialDesign:ElevationAssist.Elevation="Dp2" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Background="{DynamicResource PrimaryHueLightBrush}" Padding="16">
                    <DockPanel>
                        <TextBlock Text="Người nhận" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Chọn tất cả" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding SelectAllCommand}" Height="24" Padding="8,0" FontSize="12"/>
                            <Button Content="Bỏ chọn" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding DeselectAllCommand}" Height="24" Padding="8,0" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding Employees}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Employee.Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Employee.Email}" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </materialDesign:Card>

        <!-- Right Panel: Compose Email -->
        <materialDesign:Card Grid.Row="1" Grid.Column="2" materialDesign:ElevationAssist.Elevation="Dp2" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Soạn Email" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                
                <!-- Subject -->
                <TextBox Grid.Row="1" materialDesign:HintAssist.Hint="Tiêu đề (Subject)" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Margin="0,0,0,24"/>
                         
                <!-- Body -->
                <TextBox Grid.Row="2" materialDesign:HintAssist.Hint="Nội dung Email (Body)" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"/>
                         
                <!-- Actions -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,16,0" FontStyle="Italic" Opacity="0.7"/>
                    
                    <Button Command="{Binding SendCommand}" Width="150" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Send" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Foreground="White"
                                         Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding IsSending, Converter={StaticResource BoolToStr}, ConverterParameter='Đang gửi...|Gửi Email'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
