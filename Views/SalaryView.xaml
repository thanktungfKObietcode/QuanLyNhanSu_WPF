<UserControl x:Class="QuanLyNhanSu_WPF.Views.SalaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:QuanLyNhanSu_WPF.Helpers">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <materialDesign:Card Padding="16" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ComboBox materialDesign:HintAssist.Hint="Tháng" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" Width="80" Margin="0,0,12,0"/>
                    <ComboBox materialDesign:HintAssist.Hint="Năm" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="100" Margin="0,0,16,0"/>
                    <Button Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignFlatButton}" Content="XEM BẢNG LƯƠNG" Margin="0,0,12,0"/>
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource MaterialDesignFlatButton}" Content="📥 XUẤT EXCEL" Foreground="Green"/>
                </StackPanel>
                
                <Button Command="{Binding CalculateSalaryCommand}" DockPanel.Dock="Right" 
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="OrangeRed" BorderBrush="OrangeRed"
                        Content="➕ TÍNH LƯƠNG TẤT CẢ"/>
            </DockPanel>
        </materialDesign:Card>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Table (Admin) or List (Employee) -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <DataGrid ItemsSource="{Binding Salaries}" SelectedItem="{Binding SelectedSalary}" 
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding Employee.Name}" Width="150"/>
                            <DataGridTextColumn Header="Mã NV" Binding="{Binding Employee.Code}" Width="100"/>
                            <DataGridTextColumn Header="Lương cơ bản" Binding="{Binding BaseSalary, StringFormat={}{0:N0} ₫}" Width="120"/>
                            <DataGridTextColumn Header="Phụ cấp" Binding="{Binding Allowances, StringFormat={}{0:N0} ₫}" Width="100"/>
                            <DataGridTextColumn Header="Hoa hồng" Binding="{Binding Commission, StringFormat={}{0:N0} ₫}" Width="100"/>
                            <DataGridTextColumn Header="KPI/Thưởng" Binding="{Binding KPIBonus, StringFormat={}{0:N0} ₫}" Width="100"/>
                            <DataGridTextColumn Header="Lương OT" Binding="{Binding OTSalary, StringFormat={}{0:N0} ₫}" Width="100"/>
                            <DataGridTextColumn Header="Thực lĩnh" Binding="{Binding NetSalary, StringFormat={}{0:N0} ₫}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="Green"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ngày chi" Binding="{Binding PaidDate, StringFormat=dd/MM/yyyy}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Employee History View -->
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InvBoolToVis}}" Margin="16">
                        <TextBlock Text="Lịch sử nhận lương" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding MySalaryHistory}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="500">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tháng/Năm" Binding="{Binding StringFormat={}{0}/{1}, Path=Month, Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="Lương CB" Binding="{Binding BaseSalary, StringFormat={}{0:N0}}" Width="100"/>
                                <DataGridTextColumn Header="Phụ cấp" Binding="{Binding Allowances, StringFormat={}{0:N0}}" Width="100"/>
                                <DataGridTextColumn Header="Thực nhận" Binding="{Binding NetSalary, StringFormat={}{0:N0} ₫}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    
                    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top"/>
                </Grid>
            </materialDesign:Card>

            <!-- Payslip Preview Side -->
            <materialDesign:Card Grid.Column="1" Margin="8,0,0,0" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="PHIẾU LƯƠNG CHI TIẾT" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Separator Margin="0,0,0,16"/>
                    
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Nhân viên:"/>
                        <TextBlock Text="{Binding SelectedSalary.Employee.Name, FallbackValue='--'}" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Kỳ lương:"/>
                        <TextBlock FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Tháng {0}/{1}">
                                    <Binding Path="SelectedSalary.Month" FallbackValue="--"/>
                                    <Binding Path="SelectedSalary.Year" FallbackValue="--"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>
                    
                    <Separator Margin="0,8"/>
                    
                    <DockPanel Margin="0,4">
                        <TextBlock Text="(+) Lương cơ bản"/>
                        <TextBlock Text="{Binding SelectedSalary.BaseSalary, StringFormat={}{0:N0} ₫}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="(+) Phụ cấp (Xăng xe, ăn trưa...)"/>
                        <TextBlock Text="{Binding SelectedSalary.Allowances, StringFormat={}{0:N0} ₫}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="Green"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="(+) KPI"/>
                        <TextBlock Text="{Binding SelectedSalary.KPIBonus, StringFormat={}{0:N0} ₫}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="Green"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="(+) Hoa hồng"/>
                        <TextBlock Text="{Binding SelectedSalary.Commission, StringFormat={}{0:N0} ₫}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="Green"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="(+) Lương tăng ca (OT)"/>
                        <TextBlock Text="{Binding SelectedSalary.OTSalary, StringFormat={}{0:N0} ₫}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="Green"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="(+) Thưởng khác"/>
                        <TextBlock Text="{Binding SelectedSalary.Bonus, StringFormat={}{0:N0} ₫}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="Green"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="(-) Khấu trừ / Thuế"/>
                        <TextBlock Text="{Binding SelectedSalary.Deductions, StringFormat={}{0:N0} ₫}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="Red"/>
                    </DockPanel>
                    
                    <Separator Margin="0,16"/>
                    
                    <materialDesign:Card Background="{DynamicResource PrimaryHueDarkBrush}" Padding="12">
                        <DockPanel>
                            <TextBlock Text="THỰC LĨNH" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedSalary.NetSalary, StringFormat={}{0:N0} ₫}" Foreground="White" FontWeight="Bold" FontSize="20" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </materialDesign:Card>
                    
                    <Button Margin="0,24,0,0" Style="{StaticResource MaterialDesignOutlinedButton}" Content="XUẤT PDF PHIẾU LƯƠNG" IsEnabled="False" ToolTip="Tính năng đang phát triển"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
