<UserControl x:Class="QuanLyNhanSu_WPF.Views.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:QuanLyNhanSu_WPF.Helpers">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <helpers:PathToImageConverter x:Key="PathToImg"/>
        <helpers:EnumToVietnameseConverter x:Key="EnumToVN"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Danh Sách Nhân Sự" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                <TextBlock Text="Quản lý hồ sơ, thông tin và tài khoản của toàn bộ nhân viên" Opacity="0.6" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <!-- Search and Actions -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,24">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Margin="8,0,12,0" Opacity="0.5" Width="20" Height="20"/>
                    <TextBox Width="350" materialDesign:HintAssist.Hint="Tìm kiếm nhân sự..." 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             BorderThickness="0" materialDesign:TextFieldAssist.HasClearButton="True"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Command="{Binding AddCommand}" 
                            Content="➕ THÊM NHÂN VIÊN" 
                            Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"
                            Padding="16,0"/>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                            Content="🔄" Margin="8,0,0,0" Width="45" Padding="0"/>
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}"
                            Content="📥 EXCEL" Margin="8,0,0,0" Foreground="#059669"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- DataGrid -->
        <materialDesign:Card Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="Transparent" BorderThickness="0"
                          materialDesign:DataGridAssist.CellPadding="16 12"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="16 12"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="FontWeight" Value="ExtraBold"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nhân viên" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Margin="0,0,12,0">
                                            <Image Source="{Binding Photo, Converter={StaticResource PathToImg}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Code}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Phòng ban" Binding="{Binding Department.DeptName}" Width="150"/>
                        <DataGridTextColumn Header="Chức vụ" Binding="{Binding Position.PosName}" Width="150"/>
                        <DataGridTemplateColumn Header="Tài khoản" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon Kind="AccountCheck" Foreground="#22C55E" Width="20" Height="20" HorizontalAlignment="Center"
                                                             ToolTip="Đã có tài khoản"
                                                             Visibility="{Binding HasAccount, Converter={StaticResource BoolToVis}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Trạng thái" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" CornerRadius="12" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Active">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumToVN}}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Thao tác" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                                Command="{Binding DataContext.CreateUserAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasAccount, Converter={StaticResource InverseBoolToVis}}"
                                                Width="32" Height="32" Padding="0" Foreground="#3B82F6" ToolTip="Cấp tài khoản">
                                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Width="32" Height="32" Padding="0" Foreground="{DynamicResource PrimaryBrush}"
                                                ToolTip="Chỉnh sửa">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Width="32" Height="32" Padding="0" Foreground="#EF4444" Margin="4,0"
                                                ToolTip="Xóa/Vô hiệu hóa">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Overlay inside Card -->
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             VerticalAlignment="Top" Style="{StaticResource MaterialDesignLinearProgressBar}"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
