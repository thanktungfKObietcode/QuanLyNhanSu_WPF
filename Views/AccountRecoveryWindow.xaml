<Window x:Class="QuanLyNhanSu_WPF.Views.AccountRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:QuanLyNhanSu_WPF.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Khoi phuc truy cap" Height="430" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:NullOrEmptyToVisibilityConverter x:Key="TextToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Khoi phuc truy cap" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Dung thong tin xac minh de lay lai ten dang nhap va dat lai mat khau tam thoi." Opacity="0.7" Margin="0,6,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Nhan vien">
                <StackPanel Margin="16">
                    <TextBox materialDesign:HintAssist.Hint="Ma nhan vien"
                             Text="{Binding EmployeeCode, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="So dien thoai hoac email"
                             Text="{Binding EmployeeContact, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>
                    <Button Content="KHOI PHUC TAI KHOAN"
                            Command="{Binding RecoverEmployeeCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40" Width="220" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Quan tri">
                <StackPanel Margin="16">
                    <TextBlock Text="Nhap ma cuu ho quan tri da duoc ban giao khi trien khai he thong." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Ma cuu ho quan tri"
                             Text="{Binding AdminRecoveryKey, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>
                    <Button Content="KHOI PHUC ADMIN"
                            Command="{Binding RecoverAdminCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40" Width="180" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Border Background="#ECFDF3" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding ResultMessage, Converter={StaticResource TextToVis}}">
                <TextBlock Text="{Binding ResultMessage}" Foreground="#166534" TextWrapping="Wrap"/>
            </Border>

            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource TextToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap"/>
            </Border>

            <DockPanel>
                <ProgressBar IsIndeterminate="True" Width="140" Height="4"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Dong" Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        DockPanel.Dock="Right"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
