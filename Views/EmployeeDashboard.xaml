<UserControl x:Class="QuanLyNhanSu_WPF.Views.EmployeeDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:QuanLyNhanSu_WPF.Helpers">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Header -->
            <TextBlock Text="Trang Cá Nhân" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryHueDarkBrush}" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Profile Card -->
                <materialDesign:Card Margin="0,0,16,0" Padding="24" Width="260"
                                      materialDesign:ElevationAssist.Elevation="Dp4">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="90" Height="90" CornerRadius="45" Margin="0,0,0,12"
                                Background="{DynamicResource PrimaryHueLightBrush}">
                            <materialDesign:PackIcon Kind="Account" Width="60" Height="60"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding EmployeeInfo.Name, FallbackValue='--'}"
                                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="{Binding EmployeeInfo.Position.PosName, FallbackValue='--'}"
                                   Opacity="0.7" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding EmployeeInfo.Department.DeptName, FallbackValue='--'}"
                                   Opacity="0.6" FontSize="12" HorizontalAlignment="Center"/>
                        <Separator Margin="0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Phone" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.6"/>
                            <TextBlock Text="{Binding EmployeeInfo.PhoneNumber, FallbackValue='--'}" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <materialDesign:PackIcon Kind="Email" Width="14" Height="14" Margin="0,0,4,0" Opacity="0.6"/>
                            <TextBlock Text="{Binding EmployeeInfo.Email, FallbackValue='--'}" FontSize="11" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                        </StackPanel>
                        <Separator Margin="0,12"/>
                        <!-- Quick Actions -->
                        <Button Content="📝 Xin nghỉ phép" Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Click="BtnRequestLeave_Click"/>
                        <Button Content="📅 Xem chấm công" Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Stretch" Click="BtnViewAttendance_Click"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Right Panel -->
                <StackPanel Grid.Column="1">
                    <!-- Summary Cards -->
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <materialDesign:Card Margin="4" Padding="16"
                                              materialDesign:ElevationAssist.Elevation="Dp2">
                            <StackPanel>
                                <TextBlock Text="NGÀY CÔNG THÁNG NÀY" FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                                <TextBlock Text="{Binding WorkingDaysThisMonth}" FontSize="36" FontWeight="Bold"
                                           Foreground="#FF4CAF50"/>
                                <TextBlock Text="ngày làm việc" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="4" Padding="16"
                                              materialDesign:ElevationAssist.Elevation="Dp2">
                            <StackPanel>
                                <TextBlock Text="ĐI TRỄ THÁNG NÀY" FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                                <TextBlock Text="{Binding LateDaysThisMonth}" FontSize="36" FontWeight="Bold"
                                           Foreground="#FFFF9800"/>
                                <TextBlock Text="lần đi trễ" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="4" Padding="16"
                                              materialDesign:ElevationAssist.Elevation="Dp2">
                            <StackPanel>
                                <TextBlock Text="NGÀY PHÉP CÒN LẠI" FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                                <TextBlock Text="{Binding LeaveDaysRemaining}" FontSize="36" FontWeight="Bold"
                                           Foreground="#FF5C6BC0"/>
                                <TextBlock Text="/ 12 ngày/năm" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <!-- Last Salary -->
                    <materialDesign:Card Margin="4,0,4,12" Padding="16"
                                          materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text="💰 Lương gần nhất" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Lương cơ bản" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="{Binding LastSalary.BaseSalary, StringFormat={}{0:N0} ₫, FallbackValue='--'}"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Phụ cấp" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="{Binding LastSalary.Allowances, StringFormat={}{0:N0} ₫, FallbackValue='--'}"
                                               FontWeight="SemiBold" Foreground="#FF4CAF50"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Thưởng" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="{Binding LastSalary.Bonus, StringFormat={}{0:N0} ₫, FallbackValue='--'}"
                                               FontWeight="SemiBold" Foreground="#FF4CAF50"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Khấu trừ" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="{Binding LastSalary.Deductions, StringFormat={}{0:N0} ₫, FallbackValue='--'}"
                                               FontWeight="SemiBold" Foreground="#FFE53935"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="THỰC LĨNH" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                                    <TextBlock Text="{Binding LastSalary.NetSalary, StringFormat={}{0:N0} ₫, FallbackValue='--'}"
                                               FontWeight="Bold" FontSize="16"
                                               Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding LastSalary.Month, StringFormat=Tháng {0}/, FallbackValue=''}"
                                       Opacity="0.5" FontSize="11" Margin="0,8,0,0">
                                <Run Text="{Binding LastSalary.Year}"/>
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Recent Leave Requests -->
                    <materialDesign:Card Margin="4" Padding="16"
                                          materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text="📋 Đơn nghỉ phép gần đây" FontWeight="Bold"
                                       FontSize="14" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding RecentLeaveRequests}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      MaxHeight="200" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Style="{StaticResource MaterialDesignDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Loại" Binding="{Binding LeaveType}" Width="80"/>
                                    <DataGridTextColumn Header="Từ" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="90"/>
                                    <DataGridTextColumn Header="Đến" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="90"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Chưa có đơn nghỉ phép nào." Opacity="0.5"
                                       HorizontalAlignment="Center" Margin="8"
                                       Visibility="{Binding RecentLeaveRequests.Count, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
