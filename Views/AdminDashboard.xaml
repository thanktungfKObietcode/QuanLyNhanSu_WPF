<UserControl x:Class="QuanLyNhanSu_WPF.Views.AdminDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:helpers="clr-namespace:QuanLyNhanSu_WPF.Helpers">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Background="#80000000" Panel.ZIndex="99">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="6"
                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="Đang tải dữ liệu..." Foreground="White"
                           HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="14"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <!-- Header -->
                <DockPanel Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Dashboard Quản Trị" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                        <TextBlock FontSize="13" Opacity="0.6">
                            <Run Text="Cập nhật lúc: "/>
                            <Run Text="{Binding LastUpdated, StringFormat='HH:mm dd/MM/yyyy'}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            VerticalAlignment="Top" HorizontalAlignment="Right"
                            Content="🔄 Làm mới"/>
                </DockPanel>

                <!-- ── Row 1: 4 Stat Cards ── -->
                <UniformGrid Columns="4" Margin="0,0,0,16">

                    <!-- Total Employees -->
                    <materialDesign:Card Margin="8" Padding="0" Cursor="Hand"
                                         MouseLeftButtonUp="TotalEmployeesCard_Click"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#4F46E5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="24,20">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TỔNG NHÂN VIÊN" FontSize="11" FontWeight="Black" Foreground="#CCFFFFFF"/>
                                    <TextBlock Text="{Binding TotalEmployees}" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,4"/>
                                    <TextBlock Text="Nhân viên chính thức" FontSize="12" Foreground="#AAFFFFFF"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="AccountGroup" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Width="32" Height="32" Foreground="#44FFFFFF" Opacity="0.5"/>
                            </Grid>
                        </Border>
                    </materialDesign:Card>

                    <!-- Departments -->
                    <materialDesign:Card Margin="8" Padding="0" Cursor="Hand"
                                         MouseLeftButtonUp="TotalDepartmentsCard_Click"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="24,20">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PHÒNG BAN" FontSize="11" FontWeight="Black" Foreground="#CCFFFFFF"/>
                                    <TextBlock Text="{Binding TotalDepartments}" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,4"/>
                                    <TextBlock Text="Đã thiết lập" FontSize="12" Foreground="#AAFFFFFF"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="OfficeBuilding" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Width="32" Height="32" Foreground="#44FFFFFF" Opacity="0.5"/>
                            </Grid>
                        </Border>
                    </materialDesign:Card>

                    <!-- Pending Leaves -->
                    <!-- Pending Leaves -->
                    <materialDesign:Card Margin="8" Padding="0" Cursor="Hand"
                                         MouseLeftButtonUp="PendingLeaveCard_Click"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F59E0B" Offset="0"/>
                                    <GradientStop Color="#D97706" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="24,20">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ĐƠN NGHỈ PHÉP" FontSize="11" FontWeight="Black" Foreground="#CCFFFFFF"/>
                                    <TextBlock Text="{Binding PendingLeaveRequests}" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,4"/>
                                    <TextBlock Text="Chờ phê duyệt" FontSize="12" Foreground="#AAFFFFFF"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ClipboardClock" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Width="32" Height="32" Foreground="#44FFFFFF" Opacity="0.5"/>
                            </Grid>
                        </Border>
                    </materialDesign:Card>

                    <!-- Attendance Rate -->
                    <!-- Attendance Rate -->
                    <materialDesign:Card Margin="8" Padding="0" Cursor="Hand"
                                         MouseLeftButtonUp="AttendanceCard_Click"
                                         materialDesign:ElevationAssist.Elevation="Dp3">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EC4899" Offset="0"/>
                                    <GradientStop Color="#DB2777" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="24,20">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CHUYÊN CẦN" FontSize="11" FontWeight="Black" Foreground="#CCFFFFFF"/>
                                    <TextBlock Text="{Binding MonthlyAttendanceRate, StringFormat={}{0:F1}%}" FontSize="36" FontWeight="Black" Foreground="White" Margin="0,4"/>
                                    <TextBlock Text="Tháng hiện tại" FontSize="12" Foreground="#AAFFFFFF"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="CheckCircle" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Width="32" Height="32" Foreground="#44FFFFFF" Opacity="0.5"/>
                            </Grid>
                        </Border>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- ── Row 2: Today Summary ── -->
                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <materialDesign:Card Margin="6" Padding="16"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCheck" Width="32" Height="32"
                                                     Foreground="#FF4CAF50" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0">
                                <TextBlock Text="Hôm nay có mặt" FontSize="13" Opacity="0.7"/>
                                <TextBlock Text="{Binding EmployeesPresent}" FontSize="28"
                                           FontWeight="Bold" Foreground="#FF4CAF50"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Margin="6" Padding="16"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountOff" Width="32" Height="32"
                                                     Foreground="#FFFF9800" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0">
                                <TextBlock Text="Hôm nay nghỉ phép" FontSize="13" Opacity="0.7"/>
                                <TextBlock Text="{Binding EmployeesOnLeave}" FontSize="28"
                                           FontWeight="Bold" Foreground="#FFFF9800"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- ── Row 3: Charts ── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Attendance Trend -->
                    <materialDesign:Card Margin="6" Padding="12" Grid.Column="0"
                                          materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text="📈 Xu hướng chuyên cần (7 ngày)" FontWeight="Bold"
                                       FontSize="14" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding AttendanceTrendSeries}"
                                                Height="220" AnimationsSpeed="0:0:0.4">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding AttendanceTrendLabels}"
                                              LabelsRotation="-25"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis MinValue="0"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Department Pie Chart -->
                    <materialDesign:Card Margin="6" Padding="12" Grid.Column="1"
                                          materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text="🏢 Phân bổ phòng ban" FontWeight="Bold"
                                       FontSize="14" Margin="0,0,0,8"/>
                            <lvc:PieChart Series="{Binding DepartmentDistributionSeries}"
                                          Height="220" LegendLocation="Bottom"
                                          InnerRadius="40"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Leave Status Bar Chart -->
                    <materialDesign:Card Margin="6" Padding="12" Grid.Column="2"
                                          materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text="📝 Trạng thái nghỉ phép" FontWeight="Bold"
                                       FontSize="14" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding LeaveStatusSeries}"
                                                Height="220">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding LeaveStatusLabels}"/>
                                </lvc:CartesianChart.AxisX>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- ── Row 4: Activities + Birthdays + Quick Actions ── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Recent Activities -->
                        <materialDesign:Card Margin="6,6,6,12" Padding="12"
                                              materialDesign:ElevationAssist.Elevation="Dp2">
                            <StackPanel>
                                <TextBlock Text="📋 Hoạt động gần đây" FontWeight="Bold"
                                           FontSize="14" Margin="0,0,0,8"/>
                                <ListBox ItemsSource="{Binding RecentActivities}"
                                         MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                                        CornerRadius="4" Padding="4,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm dd/MM}"
                                                               FontSize="11" Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                                               FontFamily="Consolas"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Action}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Upcoming Birthdays -->
                        <materialDesign:Card Margin="6" Padding="12"
                                              materialDesign:ElevationAssist.Elevation="Dp2">
                            <StackPanel>
                                <TextBlock Text="🎂 Sinh nhật tháng này" FontWeight="Bold"
                                           FontSize="14" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding UpcomingBirthdays}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    Padding="4,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CakeVariant" Width="18" Height="18"
                                                                             Foreground="#FFFF9800" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DateOfBirth, StringFormat=dd/MM}"
                                                               Opacity="0.6" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Không có sinh nhật tháng này 🎉"
                                           Visibility="{Binding UpcomingBirthdays.Count, Converter={StaticResource BoolToVis}}"
                                           Opacity="0.5" HorizontalAlignment="Center" Margin="8"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>

                    <!-- Quick Actions -->
                    <materialDesign:Card Grid.Column="1" Margin="6" Padding="16"
                                          materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text="⚡ Thao tác nhanh" FontWeight="Bold"
                                       FontSize="14" Margin="0,0,0,16"/>

                            <Button x:Name="BtnManageEmployees" Content="👥 Quản lý nhân viên"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Click="BtnManageEmployees_Click"/>
                            <Button x:Name="BtnManageDepts" Content="🏢 Quản lý phòng ban"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Click="BtnManageDepts_Click"/>
                            <Button x:Name="BtnLeaveApproval" Content="📝 Duyệt nghỉ phép"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Click="BtnLeaveApproval_Click"/>
                            <Button x:Name="BtnAttendance" Content="📅 Chấm công"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                    Click="BtnAttendance_Click"/>
                            <Button x:Name="BtnSalary" Content="💰 Quản lý lương"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="BtnSalary_Click"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
