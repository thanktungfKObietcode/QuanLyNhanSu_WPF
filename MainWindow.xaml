<Window x:Class="QuanLyNhanSu_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:QuanLyNhanSu_WPF"
        xmlns:vm="clr-namespace:QuanLyNhanSu_WPF.ViewModels"
        xmlns:views="clr-namespace:QuanLyNhanSu_WPF.Views"
        mc:Ignorable="d"
        Title="MEDIA HR - Hệ Thống Quản Trị Nhân Sự" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}">
            <views:AdminDashboard/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeeDashboardViewModel}">
            <views:EmployeeDashboard/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeeManagementViewModel}">
            <views:EmployeeManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DepartmentPositionViewModel}">
            <views:DepartmentPositionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttendanceViewModel}">
            <views:AttendanceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeaveRequestViewModel}">
            <views:LeaveRequestView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalaryViewModel}">
            <views:SalaryView/>
        </DataTemplate>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="materialDesign:ListBoxItemAssist.CornerRadius" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Bar -->
        <Border DockPanel.Dock="Top" Height="75" Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                    <materialDesign:PackIcon Kind="StarFace" Width="32" Height="32" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="MEDIA HR" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="Black" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding DisplayRole}" Opacity="0.5" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    
                    <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges" UnfurlOrientation="Vertical" Cursor="Hand">
                        <materialDesign:PopupBox.ToggleContent>
                            <Border Width="48" Height="48" CornerRadius="24" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" Padding="2">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>
                        </materialDesign:PopupBox.ToggleContent>
                        <StackPanel Width="200">
                            <Button Content="👤 Hồ sơ cá nhân" Style="{StaticResource MaterialDesignFlatButton}"/>
                            <Button Content="⚙️ Cài đặt hệ thống" Style="{StaticResource MaterialDesignFlatButton}"/>
                            <Separator Background="#F1F5F9"/>
                            <Button Content="🚪 Đăng xuất" Command="{Binding LogoutCommand}" Foreground="#EF4444" Style="{StaticResource MaterialDesignFlatButton}"/>
                        </StackPanel>
                    </materialDesign:PopupBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sidebar Menu -->
        <Border DockPanel.Dock="Left" Width="260" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <ListBox ItemsSource="{Binding MenuItems}" 
                         SelectedItem="{Binding SelectedMenuItem}" 
                         ItemContainerStyle="{StaticResource SidebarItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Margin="0,32">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Height="30">
                                <materialDesign:PackIcon Kind="{Binding Icon}" Width="22" Height="22" 
                                                         VerticalAlignment="Center" Foreground="White" Opacity="0.9"/>
                                <TextBlock Text="{Binding Title}" Margin="16,0,0,0" 
                                           VerticalAlignment="Center" FontSize="14" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <!-- Bottom Info -->
                <TextBlock Text="v2.0 Premium Build" Foreground="White" Opacity="0.3" 
                           FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Background="{DynamicResource BackgroundBrush}">
            <materialDesign:Transitioner SelectedIndex="0">
                <materialDesign:TransitionerSlide>
                    <ContentControl Content="{Binding CurrentViewModel}" Margin="24"/>
                </materialDesign:TransitionerSlide>
            </materialDesign:Transitioner>
        </Grid>
    </DockPanel>
</Window>
